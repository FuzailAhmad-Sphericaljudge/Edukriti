# Edukriti AI Configuration

# Primary AI Provider: 'gemini' (default), 'openai', or 'deterministic'
LLM_PROVIDER=gemini

# Google Gemini Credentials (recommended default)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI Credentials (legacy/alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Cloudflare D1 and R2 bindings are managed by Cloudflare Workers / Wrangler
